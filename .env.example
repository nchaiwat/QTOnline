# =============================================================================
# PO-Online Environment Variables Configuration
# =============================================================================
# คัดลอกไฟล์นี้เป็น .env และแก้ไขค่าตามความเหมาะสม
# สำหรับ Production ต้องเปลี่ยนค่าทั้งหมดให้เป็นค่าจริง!
# =============================================================================

# --- Database Configuration ---
POSTGRES_USER=WAUser
POSTGRES_PASSWORD=Wa@!0302$
POSTGRES_DB=po_online_db
DB_HOST=db
DB_PORT=5432

# --- Flask Configuration ---
FLASK_APP=app.py
FLASK_ENV=production
# ⚠️ IMPORTANT: เปลี่ยนค่านี้เป็น Random String ที่ปลอดภัย!
SECRET_KEY=your_production_secret_key_change_this_in_production

# --- Security: Telegram Notifications ---
# ⚠️ IMPORTANT: ใส่ Bot Token และ Group ID ของคุณ
TELEGRAM_BOT_TOKEN=8214911655:AAG5RKU6m75AOc3Wws0FqVBqn1CicDLsVWI
TELEGRAM_GROUP_ID=-5241471050
# URL ปลายทางของ Telegram API สำหรับ Proxy (หากไม่ระบุจะใช้ http://127.0.0.1:3200 เมื่อรันตรง และ http://172.17.0.1:3200 เมื่อรันบน Docker)
# - รัน Python ตรงใน Local (เครื่องตนเอง): TELEGRAM_API_BASE_URL=http://127.0.0.1:3200
# - รันผ่าน Docker Local / VPS: TELEGRAM_API_BASE_URL=http://172.17.0.1:3200
TELEGRAM_API_BASE_URL=http://172.17.0.1:3200

# --- Security: Encryption Key ---
# ⚠️ IMPORTANT: สร้าง Key ใหม่ด้วยคำสั่ง: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=Z7wQp9L2Xn5R8vA3mJ6kH1yT4gF0cB9dE5sS8xV2N1M=

